{
  "index": "/index.html",
  "assetGroups": [
    { "name": "app-shell", "installMode": "prefetch", "updateMode": "prefetch", "resources": { "files": ["/favicon.svg", "/icons/**", "/index.html", "/*.css", "/*.js", "/manifest.webmanifest"] } },
    { "name": "event-configuration", "installMode": "prefetch", "updateMode": "prefetch", "resources": { "files": ["/data/event.json"] } },
    { "name": "local-media", "installMode": "lazy", "updateMode": "prefetch", "resources": { "files": ["/images/**", "/music/**"] } }
  ],
  "dataGroups": [
    { "name": "open-source-apis", "urls": ["https://api.jikan.moe/**", "https://pokeapi.co/api/v2/**"], "cacheConfig": { "strategy": "freshness", "maxSize": 40, "maxAge": "1d", "timeout": "5s" } }
  ],
  "navigationUrls": ["/**", "!/**/*.*", "!/config/**"]
}
